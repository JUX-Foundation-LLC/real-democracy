# ─────────────────────────────────────────────────────────────────────────────
# Real Democracy — example environment.  Copy to `.env` and fill in your OWN
# values.  NEVER commit a real .env or a real private key.
# ─────────────────────────────────────────────────────────────────────────────

# JSON-RPC endpoint of the Besu node you are talking to.
BESU_RPC_URL=http://localhost:8545
# Alias some tooling reads instead of BESU_RPC_URL:
BLOCKCHAIN_RPC_URL=http://localhost:8545

# Chain ID.  1787 is JUX Foundation's production chain; use your own for a fork.
BESU_CHAIN_ID=1787

# Deployer / signer key.  GENERATE YOUR OWN — do not reuse any key from anywhere.
#   e.g.  openssl rand -hex 32   (then prefix with 0x)
# Leave UNSET to run read-only.  If set, keep it secret; it controls funds/roles.
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
